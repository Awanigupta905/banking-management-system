digraph arch {
  rankdir=LR; fontname="Helvetica"; node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#f4f6fa"]; edge [fontname="Helvetica", fontsize=10];
  label="Banking Management System - Architecture"; labelloc=t; fontsize=16;

  subgraph cluster_clients { label="Client side (client.c)"; style=rounded; color="#7a8aa8";
    c1 [label="Customer\nmenu"]; c2 [label="Bank Employee\nmenu"]; c3 [label="Manager\nmenu"]; c4 [label="Administrator\nmenu"]; }

  subgraph cluster_server { label="Server side (server.c)"; style=rounded; color="#7a8aa8";
    parent [label="Parent process\nsocket - bind - listen\naccept() loop", fillcolor="#e3efe3"];
    child  [label="Child process (one per request)\nfork() -> recv -> process_request -> send -> exit", fillcolor="#e3efe3"];
    disp   [label="process_request()\n1. is the user logged in?\n2. does the role match (file, not client)?\n3. look up command table\n4. call handler cmd_xxx()", fillcolor="#fdf3d8"];
    log    [label="bank.log\n(write() with O_APPEND)", shape=note, fillcolor="#ffffff"];
  }

  subgraph cluster_db { label="File layer (database.c)"; style=rounded; color="#7a8aa8";
    lock  [label="fcntl() record locks\nF_SETLKW  (wait for the lock)", fillcolor="#f8e0e0"];
    files [label="data/users.txt\ndata/accounts.txt\ndata/transactions.txt\ndata/loans.txt\ndata/feedback.txt\n(fixed-length text records)", shape=folder, fillcolor="#ffffff"];
  }

  c1 -> parent [label="TCP\nport 8080"]; c2 -> parent; c3 -> parent; c4 -> parent;
  parent -> child [label="fork()"];
  child -> disp;
  disp -> lock [label="lock record"];
  lock -> files [label="pread / pwrite\n+ fsync"];
  child -> log;
}
