digraph roles {
  rankdir=TB; fontname="Helvetica"; node [fontname="Helvetica", fontsize=10, shape=record, style="rounded,filled", fillcolor="#f4f6fa"];
  label="What each role can do"; labelloc=t; fontsize=16;
  cust [label="{Customer|View balance\lDeposit / Withdraw\lTransfer funds\lApply for loan\lView my loans\lTransaction history\lAdd feedback\lChange password\lLogout / Exit\l}"];
  emp  [label="{Bank Employee|Add new customer\lModify customer details\lView customer passbook\lView assigned loans\lApprove / Reject loans\lChange password\lLogout / Exit\l}"];
  mgr  [label="{Manager|Activate / Deactivate accounts\lAssign loans to employees\lReview customer feedback\lChange password\lLogout / Exit\l}"];
  adm  [label="{Administrator|Add new bank employee\lModify customer/employee details\lManage user roles\lChange password\lLogout / Exit\l}"];
  login [label="Login (one session per user)", shape=box, fillcolor="#fdf3d8"];
  login -> cust; login -> emp; login -> mgr; login -> adm;
}
